{
    "name": "codaipro/php-s3",
    "description": "php-s3 — self-hosted S3-compatible object storage server in plain PHP, designed for shared hosting. By codaipro (Lucky Yaduvanshi).",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-openssl": "*",
        "ext-fileinfo": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "aws/aws-sdk-php": "^3.300"
    },
    "autoload": {
        "psr-4": {
            "PhpS3\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpS3\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "authors": [
        {
            "name": "Lucky Yaduvanshi",
            "homepage": "https://luckyyaduvanshi.in",
            "role": "Developer"
        }
    ]
}
